# Copy to .env.local and fill in. Never commit .env.local (it is git-ignored).

# --- Database (SQLite file, created by `npx prisma db push`) ---
DATABASE_URL="file:./dev.db"

# --- Security ---
# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- AI platform (given by the organisers; configuration only, never in code) ---
# true = offline rehearsal mode (same pipeline, simulated latency and quota). false = real platform.
MOCK_MODE=false
LLM_BASE_URL=
LLM_API_KEY=
# Tested on the platform: compact=qwen3.5-0.8b (<3B), mid=llama3.1-8b (<=16B). Leave empty to auto-pick from GET /models.
LLM_MODEL_COMPACT=
LLM_MODEL_MID=
# Optional: embeddings for RAG (separate quota). Leave empty to use keyword retrieval only.
LLM_MODEL_EMBEDDINGS=
EMBEDDINGS_BASE_URL=

# --- Resilience tuning (defaults shown) ---
# The challenge key allows 2 parallel requests in total and 20 requests per minute.
LLM_MAX_CONCURRENCY_COMPACT=1
LLM_MAX_CONCURRENCY_MID=1
LLM_RPM_LIMIT=20
LLM_MAX_TOKENS_COMPACT=220
LLM_MAX_TOKENS_MID=380
LLM_MAX_QUOTA_WAIT_MS=20000
LLM_LOW_QUOTA_THRESHOLD=3

# --- Rehearsal only: inject platform errors in MOCK_MODE (e.g. to film the fallback for the video) ---
# MOCK_FAULTS=mid503=0.3,quota429=0.1,bad400=0.05
MOCK_FAULTS=

# --- Optional: also email the 6-digit code to the parent (needs `npm i nodemailer`) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
